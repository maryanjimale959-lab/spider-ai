# SPIDER AI backend configuration.
# Copy this file to .env and adjust. Every value below is optional - the app runs with
# safe local defaults if the file is absent.

# --- Database ---------------------------------------------------------------
# SQLite (default, zero setup):
SPIDER_DATABASE_URL=sqlite:///./spider_ai.db
# PostgreSQL for deployment:
# SPIDER_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/spider_ai

# --- Secrets ----------------------------------------------------------------
# REQUIRED in production. Generate one:  python -c "import secrets;print(secrets.token_urlsafe(48))"
# Left empty, a temporary key is generated at each start (sessions end when the server restarts).
# SPIDER_SECRET_KEY=

SPIDER_ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- Uploads ----------------------------------------------------------------
SPIDER_MAX_UPLOAD_BYTES=41943040

# --- AI provider (optional) --------------------------------------------------
# The on-device analysis engine always runs. Configuring a provider only adds
# explanation, related concepts, and model-written answers to document questions.
# SPIDER_AI_PROVIDER=openai_compatible
# SPIDER_AI_BASE_URL=https://api.openai.com/v1
# SPIDER_AI_API_KEY=
# SPIDER_AI_MODEL=gpt-4o-mini
# SPIDER_AI_TIMEOUT_SECONDS=60
# SPIDER_AI_MAX_INPUT_CHARACTERS=60000

# --- CORS -------------------------------------------------------------------
# SPIDER_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
